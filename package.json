{
  "name": "local-page-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop:dev": "pnpm prepare:runtime && tauri dev",
    "desktop:build": "pnpm prepare:runtime && tauri build --bundles app,dmg",
    "prepare:runtime": "python3 scripts/prepare-runtime.py",
    "test": "node --test tests/*.test.mjs",
    "test:concurrency": "python3 scripts/test-concurrency.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "^0.468.0",
    "morphdom": "2.7.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "8.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
